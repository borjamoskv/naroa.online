{
  "version": 2,
  "cleanUrls": true,
  "buildCommand": "./deploy.sh --build-only",
  "outputDirectory": ".deploy",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "naroa.online"
        }
      ],
      "destination": "https://www.naroa.online/$1",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
